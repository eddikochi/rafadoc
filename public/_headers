# Cloudflare Pages — cabeçalhos
# Assets estáticos: cache de 7 dias (nomes sem hash; se trocar um arquivo, renomear ou aguardar)
/assets/*
  Cache-Control: public, max-age=604800
/videos/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
